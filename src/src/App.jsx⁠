export default function App() {
  // Mode: 'rw' (Read/Write - Scorer) or 'ro' (Read-Only - Spectator)
  const [accessMode, setAccessMode] = useState('rw');
  
  // Tab navigation
  const [activeTab, setActiveTab] = useState('live'); // 'live' | 'games' | 'setup' | 'roster' | 'sync'
  const [toastMessage, setToastMessage] = useState('');

  // Course & Round State
  const [courseName, setCourseName] = useState('Pinehurst No. 2');
  const [roundDate, setRoundDate] = useState(new Date().toISOString().split('T')[0]);
  const [holesCount, setHolesCount] = useState(18);
  const [holes, setHoles] = useState(PRESET_COURSES.pinehurst.holes);
  
  // Trip & Players State
  const [players, setPlayers] = useState([
    { id: 'p1', name: 'Alex M.', hcp: 8, team: 'A', color: '#10B981' },
    { id: 'p2', name: 'Jake T.', hcp: 14, team: 'A', color: '#3B82F6' },
    { id: 'p3', name: 'Ryan C.', hcp: 10, team: 'B', color: '#F59E0B' },
    { id: 'p4', name: 'Dave K.', hcp: 18, team: 'B', color: '#EC4899' },
  ]);

  const [teams, setTeams] = useState([
    { id: 'A', name: 'Team Eagles', color: 'border-emerald-500 bg-emerald-50' },
    { id: 'B', name: 'Team Birdies', color: 'border-amber-500 bg-amber-50' }
  ]);

  const [activeGame, setActiveGame] = useState('best_ball');
  const [pointsWager, setPointsWager] = useState(10);

  // Scoring matrix: scores[holeIndex][playerId] = score number
  const [scores, setScores] = useState(() => {
    const initial = {};
    for (let i = 1; i <= 18; i++) {
      initial[i] = { p1: null, p2: null, p3: null, p4: null };
    }
    return initial;
  });

  // Active scoring cursor
  const [currentHole, setCurrentHole] = useState(1);
  const [selectedPlayerId, setSelectedPlayerId] = useState('p1');
  const [sheetsWebhookUrl, setSheetsWebhookUrl] = useState('');
  const [isSyncing, setIsSyncing] = useState(false);
  const [copiedType, setCopiedType] = useState('');
  
  // 4+ Score Modal State
  const [showOtherModal, setShowOtherModal] = useState(false);
  const [manualScoreInput, setManualScoreInput] = useState('');

  // Parse URL Hash parameters on mount
  useEffect(() => {
    const hash = window.location.hash;
    if (hash) {
      try {
        const params = new URLSearchParams(hash.replace(/^#/, ''));
        const modeParam = params.get('mode');
        if (modeParam === 'readonly' || modeParam === 'ro') {
          setAccessMode('ro');
        }

        const stateParam = params.get('state');
        if (stateParam) {
          const parsed = JSON.parse(decodeURIComponent(stateParam));
          if (parsed.c) setCourseName(parsed.c);
          if (parsed.d) setRoundDate(parsed.d);
          if (parsed.h) setHolesCount(parsed.h);
          if (parsed.hl) setHoles(parsed.hl);
          if (parsed.p) setPlayers(parsed.p);
          if (parsed.t) setTeams(parsed.t);
          if (parsed.g) setActiveGame(parsed.g);
          if (parsed.w) setPointsWager(parsed.w);
          if (parsed.s) setScores(parsed.s);
          return;
        }
      } catch (e) {
        console.error("Error parsing URL state parameter", e);
      }
    }

    const saved = localStorage.getItem('GOLF_TRIP_STATE_V4');
    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        if (parsed.courseName) setCourseName(parsed.courseName);
        if (parsed.roundDate) setRoundDate(parsed.roundDate);
        if (parsed.holesCount) setHolesCount(parsed.holesCount);
        if (parsed.holes) setHoles(parsed.holes);
        if (parsed.players) setPlayers(parsed.players);
        if (parsed.teams) setTeams(parsed.teams);
        if (parsed.activeGame) setActiveGame(parsed.activeGame);
        if (parsed.pointsWager) setPointsWager(parsed.pointsWager);
        if (parsed.scores) setScores(parsed.scores);
        if (parsed.sheetsWebhookUrl) setSheetsWebhookUrl(parsed.sheetsWebhookUrl);
      } catch (e) {
        console.error("Failed to restore saved round", e);
      }
    }
  }, []);

  // Save to local storage automatically
  useEffect(() => {
    if (accessMode === 'rw') {
      const stateToSave = {
        courseName,
        roundDate,
        holesCount,
        holes,
        players,
        teams,
        activeGame,
        pointsWager,
        scores,
        sheetsWebhookUrl
      };
      localStorage.setItem('GOLF_TRIP_STATE_V4', JSON.stringify(stateToSave));
    }
  }, [accessMode, courseName, roundDate, holesCount, holes, players, teams, activeGame, pointsWager, scores, sheetsWebhookUrl]);

  // Show Toast
  const showToast = (msg) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(''), 3000);
  };

  // Switch Preset Course
  const loadPresetCourse = (presetKey) => {
    if (accessMode === 'ro') return;
    const preset = PRESET_COURSES[presetKey];
    if (preset) {
      setCourseName(preset.name);
      setHoles(preset.holes);
      setHolesCount(preset.holes.length);
      const newScores = {};
      preset.holes.forEach(h => {
        newScores[h.num] = {};
        players.forEach(p => {
          newScores[h.num][p.id] = null;
        });
      });
      setScores(newScores);
      showToast(`Loaded ${preset.name}!`);
    }
  };

  // Calculate Net strokes given per hole based on USGA handicap
  const getPlayerHoleStrokes = (playerHcp, holeHcpIndex) => {
    if (!playerHcp || playerHcp <= 0) return 0;
    const baseStrokes = Math.floor(playerHcp / holesCount);
    const remainder = playerHcp % holesCount;
    return baseStrokes + (holeHcpIndex <= remainder ? 1 : 0);
  };

  // Current hole info
  const currentHoleData = useMemo(() => {
    return holes.find(h => h.num === currentHole) || { num: currentHole, par: 4, hcp: 1, yardage: 400 };
  }, [holes, currentHole]);

  // Handle Score Input
  const handleSetScore = (holeNum, playerId, scoreValue) => {
    if (accessMode === 'ro') {
      showToast('Spectator mode: Scoring is locked');
      return;
    }
    const val = scoreValue === null || scoreValue === undefined ? null : Number(scoreValue);
    setScores(prev => ({
      ...prev,
      [holeNum]: {
        ...(prev[holeNum] || {}),
        [playerId]: val
      }
    }));
  };

  // Quick next player/hole navigation
  const advanceToNext = () => {
    const playerIdx = players.findIndex(p => p.id === selectedPlayerId);
    if (playerIdx < players.length - 1) {
      setSelectedPlayerId(players[playerIdx + 1].id);
    } else {
      if (currentHole < holesCount) {
        setCurrentHole(prev => prev + 1);
        setSelectedPlayerId(players[0].id);
      }
    }
  };

  // Calculations: Totals, Net Scores, Leaderboards
  const playerStats = useMemo(() => {
    return players.map(player => {
      let totalGross = 0;
      let totalNet = 0;
      let totalPar = 0;
      let holesPlayed = 0;
      let eagles = 0;
      let birdies = 0;
      let pars = 0;
      let bogeys = 0;
      let doublesPlus = 0;
      let stablefordPoints = 0;

      holes.slice(0, holesCount).forEach(h => {
        const gross = scores[h.num]?.[player.id];
        if (gross !== null && gross !== undefined && gross > 0) {
          holesPlayed++;
          totalGross += Number(gross);
          totalPar += h.par;
          const strokes = getPlayerHoleStrokes(player.hcp, h.hcp);
          const net = Number(gross) - strokes;
          totalNet += net;

          const diff = Number(gross) - h.par;
          if (diff <= -2) eagles++;
          else if (diff === -1) birdies++;
          else if (diff === 0) pars++;
          else if (diff === 1) bogeys++;
          else if (diff >= 2) doublesPlus++;

          // Stableford
          const netDiff = net - h.par;
          if (netDiff <= -3) stablefordPoints += 5;
          else if (netDiff === -2) stablefordPoints += 4;
          else if (netDiff === -1) stablefordPoints += 3;
          else if (netDiff === 0) stablefordPoints += 2;
          else if (netDiff === 1) stablefordPoints += 1;
          else stablefordPoints += 0;
        }
      });

      const scoreToPar = totalGross - totalPar;
      const netToPar = totalNet - totalPar;
      const quotaTarget = Math.max(1, 36 - player.hcp);
      const quotaDiff = stablefordPoints - (holesPlayed / holesCount * quotaTarget);

      return {
        ...player,
        holesPlayed,
        totalGross,
        totalNet,
        scoreToPar: holesPlayed > 0 ? (scoreToPar > 0 ? `+${scoreToPar}` : scoreToPar === 0 ? 'E' : `${scoreToPar}`) : '-',
        netToPar: holesPlayed > 0 ? (netToPar > 0 ? `+${netToPar}` : netToPar === 0 ? 'E' : `${netToPar}`) : '-',
        rawScoreToPar: scoreToPar,
        rawNetToPar: netToPar,
        eagles,
        birdies,
        pars,
        bogeys,
        doublesPlus,
        stablefordPoints,
        quotaTarget,
        quotaDiff: quotaDiff.toFixed(1)
      };
    });
  }, [players, holes, holesCount, scores]);

  // Team summary metrics
  const teamStats = useMemo(() => {
    return teams.map(team => {
      const teamPlayers = playerStats.filter(p => p.team === team.id);
      let teamBestBallGrossTotal = 0;
      let teamBestBallNetTotal = 0;
      let holesCompleted = 0;

      holes.slice(0, holesCount).forEach(h => {
        const teamGrossScores = teamPlayers
          .map(p => scores[h.num]?.[p.id])
          .filter(s => s !== null && s !== undefined && s > 0);
        
        const teamNetScores = teamPlayers
          .map(p => {
            const raw = scores[h.num]?.[p.id];
            if (raw === null || raw === undefined || raw <= 0) return null;
            return raw - getPlayerHoleStrokes(p.hcp, h.hcp);
          })
          .filter(s => s !== null);

        if (teamGrossScores.length > 0) {
          holesCompleted++;
          teamBestBallGrossTotal += Math.min(...teamGrossScores);
        }
        if (teamNetScores.length > 0) {
          teamBestBallNetTotal += Math.min(...teamNetScores);
        }
      });

      return {
        ...team,
        playerCount: teamPlayers.length,
        teamPlayers,
        holesCompleted,
        bestBallGross: teamBestBallGrossTotal,
        bestBallNet: teamBestBallNetTotal
      };
    });
  }, [teams, playerStats, holes, holesCount, scores]);

  // Game Specific Live Calculations
  const gameCalculations = useMemo(() => {
    const skinsData = [];
    let carryover = 0;
    holes.slice(0, holesCount).forEach(h => {
      const holeScores = players.map(p => {
        const raw = scores[h.num]?.[p.id];
        if (!raw) return null;
        const net = raw - getPlayerHoleStrokes(p.hcp, h.hcp);
        return { player: p, gross: raw, net };
      }).filter(Boolean);

      let winner = null;
      let skinValue = 1 + carryover;

      if (holeScores.length === players.length && players.length > 0) {
        const minNet = Math.min(...holeScores.map(s => s.net));
        const playersWithMin = holeScores.filter(s => s.net === minNet);
        if (playersWithMin.length === 1) {
          winner = playersWithMin[0].player;
          carryover = 0;
        } else {
          carryover += 1;
        }
      }

      skinsData.push({
        hole: h.num,
        par: h.par,
        skinValue,
        winner,
        carryover: winner ? 0 : carryover
      });
    });

    const vegasHoles = [];
    let teamAPoints = 0;
    let teamBPoints = 0;

    holes.slice(0, holesCount).forEach(h => {
      const teamAPlayers = players.filter(p => p.team === 'A');
      const teamBPlayers = players.filter(p => p.team === 'B');

      const sA1 = scores[h.num]?.[teamAPlayers[0]?.id];
      const sA2 = scores[h.num]?.[teamAPlayers[1]?.id];
      const sB1 = scores[h.num]?.[teamBPlayers[0]?.id];
      const sB2 = scores[h.num]?.[teamBPlayers[1]?.id];

      if (sA1 && sA2 && sB1 && sB2) {
        let aLow = Math.min(sA1, sA2);
        let aHigh = Math.max(sA1, sA2);
        let bLow = Math.min(sB1, sB2);
        let bHigh = Math.max(sB1, sB2);

        let valA = parseInt(`${aLow}${aHigh}`, 10);
        let valB = parseInt(`${bLow}${bHigh}`, 10);

        if (aLow < h.par && bLow >= h.par) {
          valB = parseInt(`${bHigh}${bLow}`, 10);
        } else if (bLow < h.par && aLow >= h.par) {
          valA = parseInt(`${aHigh}${aLow}`, 10);
        }

        const diff = valB - valA;
        if (diff > 0) teamAPoints += diff;
        else if (diff < 0) teamBPoints += Math.abs(diff);

        vegasHoles.push({
          hole: h.num,
          valA,
          valB,
          diff,
          leader: diff > 0 ? 'Team A' : diff < 0 ? 'Team B' : 'Tied'
        });
      }
    });

    let front9A = 0, front9B = 0;
    let back9A = 0, back9B = 0;
    let totalA = 0, totalB = 0;

    holes.slice(0, holesCount).forEach(h => {
      const tA = Math.min(...players.filter(p => p.team === 'A').map(p => {
        const s = scores[h.num]?.[p.id];
        return s ? s - getPlayerHoleStrokes(p.hcp, h.hcp) : 999;
      }));
      const tB = Math.min(...players.filter(p => p.team === 'B').map(p => {
        const s = scores[h.num]?.[p.id];
        return s ? s - getPlayerHoleStrokes(p.hcp, h.hcp) : 999;
      }));

      if (tA !== 999 && tB !== 999) {
        if (tA < tB) {
          if (h.num <= 9) front9A++;
          else back9A++;
          totalA++;
        } else if (tB < tA) {
          if (h.num <= 9) front9B++;
          else back9B++;
          totalB++;
        }
      }
    });

    return {
      skinsData,
      vegas: { teamAPoints, teamBPoints, vegasHoles },
      nassau: { front9A, front9B, back9A, back9B, totalA, totalB }
    };
  }, [holes, holesCount, players, scores]);

  // Score badge glyph helper
  const getScoreBadge = (gross, par) => {
    if (gross === null || gross === undefined || gross === '' || gross === 0) {
      return <span className="text-gray-400 font-mono text-xs">-</span>;
    }
    const diff = Number(gross) - par;

    if (diff <= -2) {
      return (
        <span className="inline-flex items-center justify-center w-7 h-7 rounded-full bg-amber-100 text-amber-950 border-2 border-amber-500 ring-2 ring-amber-400 font-black text-xs shadow-sm">
          {gross}
        </span>
      );
    }
    if (diff === -1) {
      return (
        <span className="inline-flex items-center justify-center w-7 h-7 rounded-full bg-emerald-100 text-emerald-950 border-2 border-emerald-600 font-black text-xs shadow-sm">
          {gross}
        </span>
      );
    }
    if (diff === 0) {
      return (
        <span className="inline-flex items-center justify-center w-7 h-7 text-gray-100 font-bold text-xs">
          {gross}
        </span>
      );
    }
    if (diff === 1) {
      return (
        <span className="inline-flex items-center justify-center w-6 h-6 rounded-none bg-orange-100 text-orange-950 border-2 border-orange-500 font-black text-xs">
          {gross}
        </span>
      );
    }
    return (
      <span className="inline-flex items-center justify-center w-6 h-6 rounded-none bg-red-100 text-red-950 border-2 border-red-600 ring-1 ring-red-400 font-black text-xs shadow-sm">
        {gross}
      </span>
    );
  };

  // Sync to Google Sheets / Webhook
  const handlePushToSheets = async () => {
    if (!sheetsWebhookUrl) {
      showToast('Please enter your Google Apps Script Webhook URL');
      return;
    }
    setIsSyncing(true);
    try {
      const payload = {
        timestamp: new Date().toISOString(),
        courseName,
        roundDate,
        players,
        scores,
        holes
      };

      await fetch(sheetsWebhookUrl, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      showToast('Scores sent to Google Sheet successfully!');
    } catch (e) {
      showToast('Network error syncing to Google Sheets');
    } finally {
      setIsSyncing(false);
    }
  };

  // Export Full CSV
  const handleExportCSV = () => {
    let csv = `Course: ${courseName}, Date: ${roundDate}, Holes: ${holesCount}\n\n`;
    csv += `Hole,${holes.slice(0, holesCount).map(h => h.num).join(',')},Total Gross,Total Net,To Par\n`;
    csv += `Par,${holes.slice(0, holesCount).map(h => h.par).join(',')},${holes.slice(0, holesCount).reduce((a,b)=>a+b.par,0)},,\n`;
    csv += `HCP,${holes.slice(0, holesCount).map(h => h.hcp).join(',')},,,\n`;

    playerStats.forEach(p => {
      const rowScores = holes.slice(0, holesCount).map(h => scores[h.num]?.[p.id] || '').join(',');
      csv += `${p.name} (HCP ${p.hcp}),${rowScores},${p.totalGross},${p.totalNet},${p.scoreToPar}\n`;
    });

    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `GolfTrip_${courseName.replace(/\s+/g, '_')}_${roundDate}.csv`;
    a.click();
    showToast('Scorecard CSV downloaded!');
  };

  // Generate & Copy Share Links
  const handleGenerateShareLink = (targetMode) => {
    const compactState = {
      c: courseName,
      d: roundDate,
      h: holesCount,
      hl: holes,
      p: players,
      t: teams,
      g: activeGame,
      w: pointsWager,
      s: scores
    };
    const encodedState = encodeURIComponent(JSON.stringify(compactState));
    const modeParam = targetMode === 'ro' ? 'mode=readonly&' : 'mode=scorer&';
    const shareUrl = `${window.location.origin}${window.location.pathname}#${modeParam}state=${encodedState}`;
    
    const tempInput = document.createElement('input');
    tempInput.value = shareUrl;
    document.body.appendChild(tempInput);
    tempInput.select();
    document.execCommand('copy');
    document.body.removeChild(tempInput);

    setCopiedType(targetMode);
    showToast(targetMode === 'ro' ? 'Spectator (Read-Only) link copied!' : 'Scorer (Read/Write) link copied!');
    setTimeout(() => setCopiedType(''), 2500);
  };

  // Add / Edit Player
  const handleAddPlayer = () => {
