              <p className="text-xs text-slate-400">Share Read-Only links with spectators or Scorer links with group leads</p>
            </div>

            {/* DUAL SHARING BOX */}
            <div className="p-4 bg-slate-900 rounded-2xl border border-slate-800 space-y-3">
              <span className="text-xs font-black uppercase tracking-wider text-slate-300 block">
                Shareable Live Round Links
              </span>

              {/* Read-Only Viewer Link Button */}
              <div className="p-3 bg-blue-950/30 border border-blue-500/40 rounded-xl space-y-2">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <Eye className="w-4 h-4 text-blue-400" />
                    <span className="text-xs font-bold text-white">Spectator Link (Read-Only)</span>
                  </div>
                  <span className="text-[10px] bg-blue-500/20 text-blue-300 font-mono px-2 py-0.5 rounded">
                    Safe for Group
                  </span>
                </div>
                <p className="text-xs text-slate-400">
                  Anyone with this link sees live scorecards, match calculations, and metrics, but cannot alter scores.
                </p>
                <button 
                  onClick={() => handleGenerateShareLink('ro')}
                  className="w-full py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-lg shadow-blue-900/30 transition active:scale-95"
                >
                  {copiedType === 'ro' ? <Check className="w-4 h-4 text-white" /> : <Copy className="w-4 h-4" />}
                  {copiedType === 'ro' ? 'Spectator Link Copied!' : 'Copy Read-Only Spectator URL'}
                </button>
              </div>

              {/* Read / Write Scorer Link Button */}
              <div className="p-3 bg-emerald-950/30 border border-emerald-500/40 rounded-xl space-y-2">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <Unlock className="w-4 h-4 text-emerald-400" />
                    <span className="text-xs font-bold text-white">Scorer Link (Read / Write)</span>
                  </div>
                  <span className="text-[10px] bg-emerald-500/20 text-emerald-300 font-mono px-2 py-0.5 rounded">
                    Lead Scorers Only
                  </span>
                </div>
                <p className="text-xs text-slate-400">
                  Allows full hole-by-hole scoring, editing, player handicap adjustments, and game format controls.
                </p>
                <button 
                  onClick={() => handleGenerateShareLink('rw')}
                  className="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-black text-xs flex items-center justify-center gap-2 shadow-lg shadow-emerald-900/30 transition active:scale-95"
                >
                  {copiedType === 'rw' ? <Check className="w-4 h-4 text-slate-950" /> : <Copy className="w-4 h-4" />}
                  {copiedType === 'rw' ? 'Scorer Link Copied!' : 'Copy Read/Write Scorer URL'}
                </button>
              </div>
            </div>

            {/* Google Sheets Webhook Integration */}
            <div className="p-4 bg-slate-900 rounded-2xl border border-slate-800 space-y-3">
              <div className="flex items-center gap-2">
                <div className="w-6 h-6 rounded bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">
                  GS
                </div>
                <span className="text-xs font-bold text-white">Google Apps Script Webhook Endpoint</span>
              </div>
              
              <p className="text-xs text-slate-400">
                Paste your free Google Apps Script Web App URL below to automatically append round scores to your trip Google Sheet.
              </p>

              <input 
                type="text" 
                placeholder="https://script.google.com/macros/s/.../exec"
                value={sheetsWebhookUrl}
                onChange={(e) => setSheetsWebhookUrl(e.target.value)}
                className="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs font-mono text-white outline-none focus:border-emerald-500"
              />

              <button 
                onClick={handlePushToSheets}
                disabled={isSyncing}
                className="w-full py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 disabled:opacity-50 text-white font-bold text-xs flex items-center justify-center gap-2 transition active:scale-95 shadow-lg shadow-blue-900/30"
              >
                <RefreshCw className={`w-4 h-4 ${isSyncing ? 'animate-spin' : ''}`} />
                {isSyncing ? 'Pushing to Google Sheet...' : 'Push Scores to Google Sheet Now'}
              </button>
            </div>

            {/* Reset / Backup Controls */}
            <div className="p-4 bg-slate-900 rounded-2xl border border-slate-800 space-y-2">
              <span className="text-xs font-bold text-slate-300 block">Round Backup & Reset</span>
              <div className="flex gap-2">
                <button 
                  onClick={handleExportCSV}
                  className="flex-1 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold border border-slate-700 flex items-center justify-center gap-1.5"
                >
                  <Download className="w-3.5 h-3.5" /> Download CSV
                </button>
                {accessMode === 'rw' && (
                  <button 
                    onClick={() => {
                      const emptyScores = {};
                      for (let i = 1; i <= 18; i++) emptyScores[i] = {};
                      setScores(emptyScores);
                      showToast('Round scores reset!');
                    }}
                    className="px-4 py-2 rounded-xl bg-red-950/40 hover:bg-red-900 text-red-300 text-xs font-bold border border-red-800/60"
                  >
                    Clear Scores
                  </button>
                )}
              </div>
            </div>
          </div>
        )}

      </main>

      {/* BOTTOM TAB NAVIGATION BAR */}
      <nav className="h-14 bg-slate-900 border-t border-slate-800 flex items-center justify-around px-2 shrink-0 z-30">
        <button 
          onClick={() => setActiveTab('live')}
          className={`flex flex-col items-center justify-center flex-1 py-1 rounded-xl transition ${activeTab === 'live' ? 'text-emerald-400 font-bold' : 'text-slate-400 hover:text-slate-200'}`}
        >
          <Flag className="w-4 h-4 mb-0.5" />
          <span className="text-[10px]">{accessMode === 'ro' ? 'Live View' : 'Live Round'}</span>
        </button>

        <button 
          onClick={() => setActiveTab('games')}
          className={`flex flex-col items-center justify-center flex-1 py-1 rounded-xl transition ${activeTab === 'games' ? 'text-emerald-400 font-bold' : 'text-slate-400 hover:text-slate-200'}`}
        >
          <Trophy className="w-4 h-4 mb-0.5" />
          <span className="text-[10px]">Leaderboard</span>
        </button>

        <button 
          onClick={() => setActiveTab('setup')}
          className={`flex flex-col items-center justify-center flex-1 py-1 rounded-xl transition ${activeTab === 'setup' ? 'text-emerald-400 font-bold' : 'text-slate-400 hover:text-slate-200'}`}
        >
          <Settings className="w-4 h-4 mb-0.5" />
          <span className="text-[10px]">Course Setup</span>
        </button>

        <button 
          onClick={() => setActiveTab('roster')}
          className={`flex flex-col items-center justify-center flex-1 py-1 rounded-xl transition ${activeTab === 'roster' ? 'text-emerald-400 font-bold' : 'text-slate-400 hover:text-slate-200'}`}
        >
          <Users className="w-4 h-4 mb-0.5" />
          <span className="text-[10px]">Players</span>
        </button>

        <button 
          onClick={() => setActiveTab('sync')}
          className={`flex flex-col items-center justify-center flex-1 py-1 rounded-xl transition ${activeTab === 'sync' ? 'text-emerald-400 font-bold' : 'text-slate-400 hover:text-slate-200'}`}
        >
          <Share2 className="w-4 h-4 mb-0.5" />
          <span className="text-[10px]">Sync & Share</span>
        </button>
      </nav>

    </div>
  );
}
